# RelayDesk 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=RelayDesk
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# ── Embedding ─────────────────────────────────────────────────────────────────
# Intent 与 RAG 共用；首次运行会下载约 1.2 GB 模型。
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_QUERY_PROMPT=query
EMBEDDING_QUERY_INSTRUCTION=Given an enterprise service desk request, retrieve the most relevant policy or troubleshooting passage that answers the request
# 更换 Embedding 模型时同步更换 collection 名，避免新旧向量混用。
RAG_COLLECTION_NAME=knowledge_base_qwen3_embedding_0_6b

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=relaydesk123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json

# ── RAG ──────────────────────────────────────────────────────────────────────
# 当前小样本负例校准的起点；更换模型后应根据本项目数据重新绘制阈值曲线。
RAG_MIN_SCORE=0.45
RAG_TIMEOUT_SECONDS=20

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
RELAYDESK_SKILLS_DIR=./skills
RELAYDESK_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
RELAYDESK_ADMIN_KEY=replace_with_a_long_random_value
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,X-RelayDesk-Admin-Key
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
